{
  "imports": {
    "dnt": "https://deno.land/x/dnt@0.40.0/mod.ts",
  },

  "tasks": {
    "dev": "deno run --watch mod.ts",
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any"],
    },
  },
  "fmt": {
    "useTabs": false,
    "semiColons": true,
    "indentWidth": 2,
    "lineWidth": 80,
    "proseWrap": "preserve",
    "singleQuote": false,
  },
}
